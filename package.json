{
  "name": "@leo_aifirst/pi-session-search",
  "version": "1.7.0",
  "description": "Index, summarize, and search past pi sessions. Covers both active and archived sessions, enabling semantic search and introspection over your coding history.",
  "type": "module",
  "keywords": [
    "pi-package",
    "extension",
    "session",
    "search",
    "semantic-search",
    "embeddings"
  ],
  "license": "MIT",
  "author": "Sam Painter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenenznze/pi-session-search.git"
  },
  "homepage": "https://github.com/zenenznze/pi-session-search#readme",
  "bugs": {
    "url": "https://github.com/zenenznze/pi-session-search/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "!src/__tests__",
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LOCAL-PATCHES.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.34",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "node --test --import tsx src/**/*.test.ts",
    "build": "esbuild src/index.ts src/index-worker.ts --bundle --platform=node --format=esm --outdir=dist --sourcemap --packages=external",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "esbuild src/index.ts src/index-worker.ts --bundle --platform=node --format=esm --outdir=dist --sourcemap --packages=external --watch",
    "prepack": "npm run build"
  }
}
